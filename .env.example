# Rust Server Demo - Environment Variables

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WORKERS=0
SERVER_MAX_BODY_SIZE=10
SERVER_REQUEST_TIMEOUT=30
SERVER_CORS_ENABLED=true
SERVER_COMPRESSION_ENABLED=true

# Application Environment
APP_ENV=development
RUST_LOG=info

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rust_server
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT=10
DB_IDLE_TIMEOUT=600
DB_MAX_LIFETIME=1800
DB_ENABLE_LOGGING=true
DB_AUTO_MIGRATE=true
DB_SLOW_QUERY_THRESHOLD=100

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_MAX_RECONNECTS=10
REDIS_RECONNECT_DELAY=1000
REDIS_CONNECT_TIMEOUT=5
REDIS_DEFAULT_EXPIRATION=3600
REDIS_POOL_SIZE=10

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=rust-server-group
KAFKA_SESSION_TIMEOUT=10000
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_MESSAGE_TIMEOUT=30
KAFKA_MAX_POLL_RECORDS=100
KAFKA_TOPICS=
KAFKA_PRODUCER_PREFIX=rust-server

# JWT Configuration
JWT_SECRET=change-this-secret-in-production-use-at-least-32-characters-long
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
JWT_ISSUER=rust-server
JWT_AUDIENCE=rust-server-users

# OpenTelemetry / Jaeger (Optional)
JAEGER_ENDPOINT=http://localhost:14268/api/traces
